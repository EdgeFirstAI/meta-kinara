[Unit]
Description=Kinara Ara2 Proxy Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/share/rt-sdk-ara240_2.1.1/proxy
ExecStartPre=/usr/libexec/ara2/uiodma.sh
ExecStartPre=/usr/share/rt-sdk-ara240_2.1.1/hw_utils/bins/active_enable -e 0 -m 2
ExecStartPre=/usr/share/rt-sdk-ara240_2.1.1/hw_utils/bins/program_pll -e 0 -p 0
ExecStartPre=/usr/share/rt-sdk-ara240_2.1.1/hw_utils/bins/ddr_mem_united_config -e 0 -d 0 -s 0 -g 1 -u 1 -m 1 -l 3 -b willow -o /usr/share/rt-sdk-ara240_2.1.1/hw_utils/ddr_config/ddr_cfg_31.bin
ExecStartPre=/usr/bin/rm -f /var/run/dvproxy.pid
ExecStartPre=-/usr/bin/killall -9 kinara_main
ExecStart=/usr/share/rt-sdk-ara240_2.1.1/proxy/proxy_ara240 --config /usr/share/rt-sdk-ara240_2.1.1/config/proxy_config.yaml
Restart=always

[Install]
WantedBy=multi-user.target
